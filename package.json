{
  "name": "odd-atom",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.5.0"
  },
  "description": "Original long-form explanatory animation made with Remotion and layered artwork",
  "scripts": {
    "dev": "remotion studio src/index.ts --browser-executable=/usr/bin/chromium",
    "render": "node scripts/render_final.cjs",
    "render:preview": "remotion render src/index.ts StarBalancePreview assets/videos/star-balance-20s-visual-preview.mp4 --browser-executable=/usr/bin/chromium --concurrency=3 --crf=16 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts StarBalancePreview assets/videos/star-balance-20s-poster.png --frame=45 --browser-executable=/usr/bin/chromium",
    "narrate": "node --use-env-proxy --use-system-ca scripts/elevenlabs_narration.mjs",
    "narrate:crowd": "node --use-env-proxy --use-system-ca scripts/elevenlabs_narration.mjs crowd",
    "render:crowd": "node scripts/render_final.cjs crowd",
    "render:crowd-rebuilt": "node scripts/render_final.cjs crowd-rebuilt",
    "render:approved-characters": "node scripts/render_final.cjs approved-characters",
    "sound:crowd": "python scripts/crowd_sound_design.py",
    "assets:crowd": "node scripts/export_crowd_assets.cjs",
    "assets:crowd-rebuilt": "node scripts/export_connection_art.cjs",
    "character": "node scripts/export_character.cjs",
    "sound": "python scripts/star_sound_design.py",
    "typecheck": "tsc --noEmit",
    "render:characters-motion": "node scripts/render_final.cjs characters-motion",
    "narrate:characters-motion": "node --use-env-proxy --use-system-ca scripts/elevenlabs_narration.mjs crowd-motion",
    "sound:characters-motion": "python scripts/motion_sound_design.py",
    "review:characters-motion": "node scripts/check_motion_geometry.cjs && python scripts/review_motion_characters.py",
    "render:artwork-motion": "node scripts/render_artwork_motion.cjs",
    "still:artwork-motion": "node scripts/render_artwork_motion.cjs --stills",
    "sound:artwork-motion": "python scripts/artwork_motion_sound.py",
    "review:artwork-motion": "node scripts/check_artwork_motion.cjs && python scripts/review_artwork_motion.py",
    "build:medicine-vector": "python scripts/build_medicine_vector.py",
    "render:medicine-vector": "remotion still src/index.ts MedicineVectorArtwork assets/scenes/medicine-vector/medicine-scene-remotion.png --browser-executable=/usr/bin/chromium",
    "review:medicine-vector": "python scripts/review_medicine_vector.py",
    "assets:medicine-layers": "node scripts/export_medicine_layers.cjs",
    "render:medicine-layers": "node scripts/render_medicine_layers.cjs",
    "still:medicine-layers": "node scripts/render_medicine_layers.cjs --stills",
    "prepare:singularity-audio": "python scripts/prepare_singularity_audio.py",
    "sprites:singularity": "node scripts/export_singularity_sprites.cjs",
    "sound:singularity": "python scripts/singularity_sound.py",
    "still:singularity": "node scripts/render_singularity.cjs --stills",
    "render:singularity": "node scripts/render_singularity.cjs",
    "review:singularity": "python scripts/review_singularity.py",
    "render:transitions": "node scripts/render_transition_lab.cjs",
    "still:transitions": "node scripts/render_transition_lab.cjs --stills",
    "sound:transitions": "python scripts/transition_lab_sound.py",
    "review:transitions": "python scripts/review_transition_lab.py",
    "render:story-motion": "node scripts/render_story_motion.cjs",
    "still:story-motion": "node scripts/render_story_motion.cjs --stills",
    "sound:story-motion": "python scripts/story_motion_sound.py",
    "review:story-motion": "python scripts/review_story_motion.py"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@remotion/cli": "4.0.538",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
